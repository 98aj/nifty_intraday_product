# Upstox API v2 — never commit real credentials.
UPSTOX_API_KEY=
UPSTOX_SECRET_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback

# Which broker executes LIVE orders. Market data, the option chain and the
# price feed always come from Upstox regardless of this setting.
#   upstox  (default) — orders go to Upstox (uses the UPSTOX_* token above)
#   zerodha           — orders go to Zerodha (needs the ZERODHA_* keys below)
ORDER_BROKER=upstox

# Zerodha Kite Connect — only needed when ORDER_BROKER=zerodha.
# Create an app at https://developers.kite.trade for the api key/secret.
# The access token expires every morning; refresh it with
#   python scripts/zerodha_session.py
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# MOCK (default) never hits the order endpoint. LIVE places real MIS orders.
EXECUTION_MODE=MOCK
ACTIVE_STRATEGY=ORB_TIGHT
